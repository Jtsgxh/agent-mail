[Unit]
Description=Agent Mailbox online database backup
After=agent-mailbox.service

[Service]
Type=oneshot
User=agent-mailbox
Group=agent-mailbox
ExecStart=/usr/bin/python3 /etc/agent-mailbox/backup.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-mailbox /var/backups/agent-mailbox
